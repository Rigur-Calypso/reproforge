[Unit]
Description=ReproForge Cloud Reproduction Server
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/reproforge
ExecStart=/opt/reproforge/.venv/bin/reproforge serve --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
